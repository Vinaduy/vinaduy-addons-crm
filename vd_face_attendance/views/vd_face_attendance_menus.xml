<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menu gốc mở THẲNG màn hình chấm công (bỏ submenu "Máy chấm công" trùng) -->
    <menuitem id="menu_face_root" name="Chấm công" sequence="55"
              action="action_face_checkin"/>

    <!-- KIOSK: 1 thiết bị (iPad) chấm cho tất cả — tự nhận diện. -->
    <menuitem id="menu_face_kiosk" name="Máy chấm công (Kiosk)"
              parent="menu_face_root" sequence="10"
              action="action_face_kiosk"/>

    <!-- Bảng chấm công: NV xem của mình, quản lý xem tất cả (record rule lọc) -->
    <menuitem id="menu_face_records" name="Bảng chấm công"
              parent="menu_face_root" sequence="20"
              action="action_face_attendance_records"/>

    <!-- Danh sách khuôn mặt đã đăng ký (kèm ảnh + mã số + giới tính) -->
    <menuitem id="menu_face_employees" name="Khuôn mặt đã đăng ký"
              parent="menu_face_root" sequence="30"
              action="action_face_employees"/>

    <!-- Cấu hình: chỉ quản lý -->
    <menuitem id="menu_face_settings" name="Cấu hình"
              parent="menu_face_root" sequence="90"
              action="action_face_settings"
              groups="vd_face_attendance.group_face_manager"/>
</odoo>
