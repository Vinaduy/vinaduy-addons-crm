<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_face_employee_list" model="ir.ui.view">
        <field name="name">vd.face.employee.list</field>
        <field name="model">vd.face.employee</field>
        <field name="arch" type="xml">
            <list string="Khuôn mặt đã đăng ký" create="0">
                <field name="photo" widget="image" options="{'size': [45, 45]}"/>
                <field name="code"/>
                <field name="name"/>
                <field name="gender"/>
                <field name="user_id"/>
                <field name="enrolled_date"/>
            </list>
        </field>
    </record>

    <record id="view_face_employee_form" model="ir.ui.view">
        <field name="name">vd.face.employee.form</field>
        <field name="model">vd.face.employee</field>
        <field name="arch" type="xml">
            <form string="Khuôn mặt đã đăng ký" create="0">
                <sheet>
                    <field name="photo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="code"/>
                        <h1><field name="code" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="gender"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="enrolled_date" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_face_employees" model="ir.actions.act_window">
        <field name="name">Khuôn mặt đã đăng ký</field>
        <field name="res_model">vd.face.employee</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
