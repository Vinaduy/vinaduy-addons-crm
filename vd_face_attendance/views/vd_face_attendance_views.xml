<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= MÀN HÌNH CHẤM CÔNG (client action) ================= -->
    <record id="action_face_checkin" model="ir.actions.client">
        <field name="name">Chấm công khuôn mặt</field>
        <field name="tag">vd_face_attendance_checkin</field>
    </record>

    <!-- ================= DANH SÁCH BẢN GHI CHẤM CÔNG ================= -->
    <record id="view_face_attendance_list" model="ir.ui.view">
        <field name="name">vd.face.attendance.list</field>
        <field name="model">vd.face.attendance</field>
        <field name="arch" type="xml">
            <list string="Chấm công khuôn mặt" create="0">
                <field name="employee_id"/>
                <field name="user_id" optional="hide"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="worked_hours" widget="float_time" sum="Tổng giờ"/>
                <field name="late_minutes" optional="show"/>
                <field name="early_leave_minutes" optional="show"/>
                <field name="in_distance" optional="show"/>
                <field name="out_distance" optional="hide"/>
                <field name="in_face_score" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_face_attendance_form" model="ir.ui.view">
        <field name="name">vd.face.attendance.form</field>
        <field name="model">vd.face.attendance</field>
        <field name="arch" type="xml">
            <form string="Chấm công khuôn mặt" create="0" edit="0">
                <sheet>
                    <group>
                        <group string="Thông tin">
                            <field name="employee_id"/>
                            <field name="user_id"/>
                            <field name="check_in"/>
                            <field name="check_out"/>
                            <field name="worked_hours" widget="float_time"/>
                        </group>
                        <group string="Vị trí / Nhận diện">
                            <field name="in_distance"/>
                            <field name="out_distance"/>
                            <field name="in_face_score"/>
                            <field name="out_face_score"/>
                        </group>
                    </group>
                    <group>
                        <group string="Ảnh chấm vào">
                            <field name="in_photo" widget="image" nolabel="1"/>
                        </group>
                        <group string="Ảnh chấm ra">
                            <field name="out_photo" widget="image" nolabel="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_face_attendance_search" model="ir.ui.view">
        <field name="name">vd.face.attendance.search</field>
        <field name="model">vd.face.attendance</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="user_id"/>
                <filter name="today" string="Hôm nay"
                        domain="[('check_in','>=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <filter name="open" string="Chưa chấm ra" domain="[('check_out','=',False)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="g_emp" string="Nhân viên" context="{'group_by':'employee_id'}"/>
                    <filter name="g_user" string="Tài khoản" context="{'group_by':'user_id'}"/>
                    <filter name="g_day" string="Ngày" context="{'group_by':'check_in:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_face_attendance_records" model="ir.actions.act_window">
        <field name="name">Bảng chấm công</field>
        <field name="res_model">vd.face.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_face_attendance_search"/>
        <field name="context">{'search_default_today': 1}</field>
    </record>
</odoo>
