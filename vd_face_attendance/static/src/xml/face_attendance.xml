<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="vd_face_attendance.Checkin">
        <div class="o_vd_face_wrap">
            <div class="o_vd_face_card">
                <div class="o_vd_face_head">
                    <i class="fa fa-camera me-2"/> CHẤM CÔNG KHUÔN MẶT
                    <span class="o_vd_face_user"><t t-esc="state.userName"/></span>
                </div>

                <div t-if="state.phase === 'error'" class="o_vd_face_error">
                    <i class="fa fa-exclamation-triangle me-2"/><t t-esc="state.msg"/>
                </div>

                <div class="o_vd_face_body">
                    <div class="o_vd_face_camwrap">
                        <video t-ref="video" class="o_vd_face_video" autoplay="autoplay"
                               muted="muted" playsinline="playsinline"/>
                        <canvas t-ref="canvas" class="d-none"/>
                        <!-- Khung oval hướng dẫn: xanh khi mặt tốt, cam khi chưa đạt -->
                        <div t-att-class="'o_vd_face_guide o_vd_face_guide_' + state.faceLive"/>
                        <div t-att-class="'o_vd_face_guidetxt o_vd_face_guidetxt_' + state.faceLive">
                            <t t-esc="state.faceHint"/>
                        </div>
                        <div t-if="state.phase === 'loading'" class="o_vd_face_overlay">
                            <i class="fa fa-spinner fa-spin me-2"/><t t-esc="state.msg"/>
                        </div>
                        <div t-if="state.faceMsg" class="o_vd_face_facemsg">
                            <t t-esc="state.faceMsg"/>
                        </div>
                    </div>

                    <div class="o_vd_face_side">
                        <!-- Trạng thái GPS -->
                        <div class="o_vd_face_row">
                            <span class="o_vd_face_lbl"><i class="fa fa-map-marker me-1"/> Vị trí</span>
                            <span t-if="!state.gpsOk and !state.gpsErr" class="o_vd_face_bad">Đang lấy GPS…</span>
                            <span t-elif="!state.gpsOk" class="o_vd_face_bad">Chưa lấy được GPS</span>
                            <span t-elif="state.withinRadius" class="o_vd_face_ok">
                                Trong văn phòng (<t t-esc="state.distance"/> m)
                            </span>
                            <span t-else="" class="o_vd_face_bad">
                                Cách VP <t t-esc="state.distance"/> m (cho phép <t t-esc="state.radius"/> m)
                            </span>
                        </div>
                        <!-- Lý do lỗi GPS + nút thử lại -->
                        <div t-if="state.gpsErr" class="o_vd_face_gpserr">
                            <i class="fa fa-exclamation-circle me-1"/><t t-esc="state.gpsErr"/>
                        </div>
                        <button t-if="!state.gpsOk" class="btn btn-outline-secondary o_vd_face_gpsbtn"
                                t-on-click="() => this.retryGps()">
                            <i class="fa fa-refresh me-1"/> Lấy lại vị trí
                        </button>

                        <!-- Trạng thái đăng ký -->
                        <div class="o_vd_face_row">
                            <span class="o_vd_face_lbl"><i class="fa fa-user me-1"/> Khuôn mặt</span>
                            <span t-if="state.enrolled" class="o_vd_face_ok">Đã đăng ký</span>
                            <span t-else="" class="o_vd_face_bad">Chưa đăng ký</span>
                        </div>

                        <!-- Trạng thái hôm nay: giờ vào / giờ ra + đi muộn / về sớm -->
                        <div class="o_vd_face_today">
                            <div class="o_vd_face_today_head"><i class="fa fa-clock-o me-1"/> Hôm nay</div>
                            <div t-if="!state.today" class="o_vd_face_muted">Chưa chấm công</div>
                            <div t-else="" class="o_vd_face_today_body">
                                <div class="o_vd_face_time">
                                    <span class="o_vd_face_time_lbl">Vào</span>
                                    <span class="o_vd_face_time_val"><t t-esc="state.today.in_time or '—'"/></span>
                                    <span t-if="state.today.late_minutes" class="o_vd_face_late">muộn <t t-esc="state.today.late_minutes"/>'</span>
                                </div>
                                <div class="o_vd_face_time">
                                    <span class="o_vd_face_time_lbl">Ra</span>
                                    <span class="o_vd_face_time_val"><t t-esc="state.today.out_time or '—'"/></span>
                                    <span t-if="state.today.early_leave_minutes" class="o_vd_face_late">sớm <t t-esc="state.today.early_leave_minutes"/>'</span>
                                </div>
                                <div t-if="state.today.out_time" class="o_vd_face_worked">
                                    Tổng: <t t-esc="state.today.worked_hours"/> giờ
                                </div>
                            </div>
                        </div>
                        <div class="o_vd_face_rulehint">Quy định: vào <t t-esc="state.workStart"/> · ra <t t-esc="state.workEnd"/></div>

                        <!-- FORM đăng ký (khi CHƯA đăng ký): nhập tên + giới tính -->
                        <div t-if="!state.enrolled" class="o_vd_face_enroll">
                            <div class="o_vd_face_enroll_title">
                                <i class="fa fa-id-card me-1"/> Đăng ký khuôn mặt
                            </div>
                            <input type="text" class="form-control o_vd_face_input"
                                   placeholder="Tên nhân viên"
                                   t-model="state.enrollName"/>
                            <select class="form-select o_vd_face_input" t-model="state.enrollGender">
                                <option value="male">Nam</option>
                                <option value="female">Nữ</option>
                                <option value="other">Khác</option>
                            </select>
                            <div class="o_vd_face_hint">Mã số nhân viên sẽ được cấp tự động.</div>
                            <button class="btn btn-warning o_vd_face_btn"
                                    t-att-disabled="state.busy or state.phase !== 'ready'"
                                    t-on-click="() => this.enroll()">
                                <i class="fa fa-user-plus me-1"/> Đăng ký khuôn mặt
                            </button>
                        </div>

                        <!-- Đã vào + đã ra -> hoàn thành -->
                        <div t-if="state.today and state.today.out_time"
                             class="o_vd_face_done">
                            <i class="fa fa-check-circle me-1"/> Đã hoàn thành chấm công hôm nay
                        </div>

                        <!-- THẺ đã đăng ký (kèm ảnh + mã số + tên + giới tính) -->
                        <div t-if="state.reg" class="o_vd_face_regcard">
                            <img t-if="state.reg.photo" class="o_vd_face_regimg"
                                 t-att-src="state.reg.photo" alt="Ảnh đăng ký"/>
                            <div class="o_vd_face_reginfo">
                                <div class="o_vd_face_regcode"><t t-esc="state.reg.code"/></div>
                                <div class="o_vd_face_regname"><t t-esc="state.reg.name"/></div>
                                <div class="o_vd_face_reggender"><t t-esc="state.reg.gender"/></div>
                            </div>
                        </div>

                        <button t-if="state.enrolled" class="btn btn-link o_vd_face_reenroll"
                                t-att-disabled="state.busy or state.phase !== 'ready'"
                                t-on-click="() => this.enroll()">
                            <i class="fa fa-refresh me-1"/> Đăng ký lại khuôn mặt
                        </button>
                    </div>
                </div>

                <!-- THANH NÚT CHẤM CÔNG — dính đáy, luôn thấy trên điện thoại -->
                <div t-if="state.enrolled and (!state.today or state.hasOpen)"
                     class="o_vd_face_actionbar">
                    <button t-if="!state.today"
                            class="btn btn-success o_vd_face_btn o_vd_face_btn_big"
                            t-att-disabled="state.busy or state.phase !== 'ready'"
                            t-on-click="() => this.checkIn()">
                        <i class="fa fa-sign-in me-1"/> CHẤM VÀO
                    </button>
                    <button t-if="state.hasOpen"
                            class="btn btn-primary o_vd_face_btn o_vd_face_btn_big"
                            t-att-disabled="state.busy or state.phase !== 'ready'"
                            t-on-click="() => this.checkOut()">
                        <i class="fa fa-sign-out me-1"/> CHẤM RA
                    </button>
                </div>

                <!-- Lịch sử gần đây -->
                <div t-if="state.recent.length" class="o_vd_face_recent">
                    <div class="o_vd_face_recent_head">Lịch sử gần đây</div>
                    <table class="table table-sm o_vd_face_table">
                        <thead>
                            <tr>
                                <th>Ngày</th><th>Vào</th><th>Ra</th>
                                <th class="text-end">Giờ</th><th>Ghi chú</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="state.recent" t-as="r" t-key="r_index">
                                <td><t t-esc="r.date or '—'"/></td>
                                <td><t t-esc="r.in_time or '—'"/></td>
                                <td><t t-esc="r.out_time or '—'"/></td>
                                <td class="text-end"><t t-esc="r.worked_hours"/></td>
                                <td>
                                    <span t-if="r.late_minutes" class="o_vd_face_late">muộn <t t-esc="r.late_minutes"/>'</span>
                                    <span t-if="r.early_leave_minutes" class="o_vd_face_late">sớm <t t-esc="r.early_leave_minutes"/>'</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </t>
</templates>
