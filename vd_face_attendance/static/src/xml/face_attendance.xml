<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="vd_face_attendance.Checkin">
        <div class="o_vd_face_wrap">
            <div class="o_vd_face_card">
                <div class="o_vd_face_head">
                    <i class="fa fa-camera me-2"/> MÁY CHẤM CÔNG KHUÔN MẶT
                    <span class="o_vd_face_user"><t t-esc="state.facesCount"/> người đã đăng ký</span>
                </div>

                <div t-if="state.phase === 'error'" class="o_vd_face_error">
                    <i class="fa fa-exclamation-triangle me-2"/><t t-esc="state.msg"/>
                </div>

                <div class="o_vd_face_body">
                    <div class="o_vd_face_camwrap">
                        <video t-ref="video" class="o_vd_face_video" autoplay="autoplay"
                               muted="muted" playsinline="playsinline"/>
                        <canvas t-ref="canvas" class="d-none"/>
                        <div t-att-class="'o_vd_face_guide o_vd_face_guide_' + state.faceLive"/>
                        <div t-att-class="'o_vd_face_guidetxt o_vd_face_guidetxt_' + state.faceLive">
                            <t t-esc="state.faceHint"/>
                        </div>
                        <div t-if="state.phase === 'loading'" class="o_vd_face_overlay">
                            <i class="fa fa-spinner fa-spin me-2"/><t t-esc="state.msg"/>
                        </div>
                        <div t-if="state.faceMsg" class="o_vd_face_facemsg">
                            <t t-esc="state.faceMsg"/>
                        </div>
                    </div>

                    <div class="o_vd_face_side">
                        <!-- Trạng thái GPS -->
                        <div class="o_vd_face_row">
                            <span class="o_vd_face_lbl"><i class="fa fa-map-marker me-1"/> Vị trí</span>
                            <span t-if="!state.gpsOk and !state.gpsErr" class="o_vd_face_bad">Đang lấy GPS…</span>
                            <span t-elif="!state.gpsOk" class="o_vd_face_bad">Chưa lấy được GPS</span>
                            <span t-elif="state.withinRadius" class="o_vd_face_ok">
                                Trong văn phòng (<t t-esc="state.distance"/> m)
                            </span>
                            <span t-else="" class="o_vd_face_bad">
                                Cách VP <t t-esc="state.distance"/> m (cho phép <t t-esc="state.radius"/> m)
                            </span>
                        </div>
                        <div t-if="state.gpsErr" class="o_vd_face_gpserr">
                            <i class="fa fa-exclamation-circle me-1"/><t t-esc="state.gpsErr"/>
                        </div>
                        <button t-if="!state.gpsOk" class="btn btn-outline-secondary o_vd_face_gpsbtn"
                                t-on-click="() => this.retryGps()">
                            <i class="fa fa-refresh me-1"/> Lấy lại vị trí
                        </button>

                        <!-- KẾT QUẢ NHẬN DIỆN — hiện TO tên + mã NV -->
                        <div t-if="state.result" t-att-class="'o_vd_face_result ' + (state.result.ok ? 'o_vd_face_result_ok' : 'o_vd_face_result_bad')">
                            <div t-if="state.result.name" class="o_vd_face_result_name">
                                <i class="fa fa-user-circle me-1"/><t t-esc="state.result.name"/>
                                <span t-if="state.result.code" class="o_vd_face_result_code">(<t t-esc="state.result.code"/>)</span>
                            </div>
                            <div class="o_vd_face_result_line"><t t-esc="state.result.line"/></div>
                        </div>

                        <div class="o_vd_face_rulehint">Quy định: vào <t t-esc="state.workStart"/> · ra <t t-esc="state.workEnd"/></div>

                        <!-- ĐĂNG KÝ khuôn mặt mới (ẩn/hiện) -->
                        <button class="btn btn-link o_vd_face_reenroll"
                                t-on-click="() => this.toggleEnroll()">
                            <i class="fa fa-user-plus me-1"/>
                            <t t-if="!state.showEnroll">Đăng ký khuôn mặt mới</t>
                            <t t-else="">Đóng đăng ký</t>
                        </button>
                        <div t-if="state.showEnroll" class="o_vd_face_enroll">
                            <div class="o_vd_face_enroll_title">
                                <i class="fa fa-id-card me-1"/> Đăng ký người mới
                            </div>
                            <input type="text" class="form-control o_vd_face_input"
                                   placeholder="Tên nhân viên"
                                   t-model="state.enrollName"/>
                            <select class="form-select o_vd_face_input" t-model="state.enrollGender">
                                <option value="male">Nam</option>
                                <option value="female">Nữ</option>
                                <option value="other">Khác</option>
                            </select>
                            <div class="o_vd_face_hint">Mã số nhân viên sẽ được cấp tự động.</div>
                            <button class="btn btn-warning o_vd_face_btn"
                                    t-att-disabled="state.busy or state.phase !== 'ready'"
                                    t-on-click="() => this.enroll()">
                                <i class="fa fa-check me-1"/> Lưu khuôn mặt
                            </button>
                        </div>
                    </div>
                </div>

                <!-- THANH NÚT CHẤM CÔNG — luôn hiện (kiosk cho tất cả) -->
                <div class="o_vd_face_actionbar">
                    <button class="btn btn-success o_vd_face_btn o_vd_face_btn_big"
                            t-att-disabled="state.busy or state.phase !== 'ready'"
                            t-on-click="() => this.checkIn()">
                        <i class="fa fa-sign-in me-1"/> CHẤM VÀO
                    </button>
                    <button class="btn btn-primary o_vd_face_btn o_vd_face_btn_big"
                            t-att-disabled="state.busy or state.phase !== 'ready'"
                            t-on-click="() => this.checkOut()">
                        <i class="fa fa-sign-out me-1"/> CHẤM RA
                    </button>
                </div>

                <!-- Lịch sử gần đây (mọi người) -->
                <div t-if="state.recent.length" class="o_vd_face_recent">
                    <div class="o_vd_face_recent_head">Lượt chấm gần đây</div>
                    <table class="table table-sm o_vd_face_table">
                        <thead>
                            <tr>
                                <th>Nhân viên</th><th>Ngày</th><th>Vào</th><th>Ra</th><th>Ghi chú</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="state.recent" t-as="r" t-key="r_index">
                                <td><b><t t-esc="r.name or '—'"/></b> <span class="o_vd_face_muted"><t t-esc="r.code or ''"/></span></td>
                                <td><t t-esc="r.date or '—'"/></td>
                                <td><t t-esc="r.in_time or '—'"/></td>
                                <td><t t-esc="r.out_time or '—'"/></td>
                                <td>
                                    <span t-if="r.late_minutes" class="o_vd_face_late">muộn <t t-esc="r.late_minutes"/>'</span>
                                    <span t-if="r.early_leave_minutes" class="o_vd_face_late">sớm <t t-esc="r.early_leave_minutes"/>'</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </t>
</templates>
