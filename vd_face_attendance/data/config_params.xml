<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Toạ độ văn phòng mặc định (link Google Maps user cấp 2026-09-18):
             https://maps.app.goo.gl/cyxpQNyhD257umxY6 -> 20.9565530, 105.8065720 -->
        <record id="param_office_lat" model="ir.config_parameter">
            <field name="key">vd_face_attendance.office_lat</field>
            <field name="value">20.9565530</field>
        </record>
        <record id="param_office_lng" model="ir.config_parameter">
            <field name="key">vd_face_attendance.office_lng</field>
            <field name="value">105.8065720</field>
        </record>
        <record id="param_radius" model="ir.config_parameter">
            <field name="key">vd_face_attendance.radius_m</field>
            <field name="value">50</field>
        </record>
        <record id="param_threshold" model="ir.config_parameter">
            <field name="key">vd_face_attendance.face_threshold</field>
            <field name="value">0.5</field>
        </record>
        <!-- Giờ quy định dạng HH:MM: 08:00 vào, 17:30 ra -->
        <record id="param_work_start" model="ir.config_parameter">
            <field name="key">vd_face_attendance.work_start</field>
            <field name="value">08:00</field>
        </record>
        <record id="param_work_end" model="ir.config_parameter">
            <field name="key">vd_face_attendance.work_end</field>
            <field name="value">17:30</field>
        </record>
    </data>
</odoo>
