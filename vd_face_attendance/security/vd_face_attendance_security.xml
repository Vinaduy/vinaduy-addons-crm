<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_face_manager" model="res.groups">
        <field name="name">Chấm công khuôn mặt / Quản lý</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- NV thường: chỉ thấy bản ghi chấm công CỦA MÌNH -->
    <record id="rule_face_att_own" model="ir.rule">
        <field name="name">Chấm công: NV chỉ xem của mình</field>
        <field name="model_id" ref="model_vd_face_attendance"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Quản lý: xem TẤT CẢ -->
    <record id="rule_face_att_manager" model="ir.rule">
        <field name="name">Chấm công: quản lý xem tất cả</field>
        <field name="model_id" ref="model_vd_face_attendance"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_face_manager'))]"/>
    </record>
</odoo>
