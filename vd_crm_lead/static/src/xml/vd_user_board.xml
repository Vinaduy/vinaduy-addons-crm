<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="vd_crm_lead.VdUserBoard">
        <div class="o_vdnv">
            <!-- Thanh trên: tiêu đề + tìm + thêm -->
            <div class="o_vdnv_bar">
                <h2 class="o_vdnv_h">👥 Quản lý nhân viên</h2>
                <input class="o_vdnv_search" placeholder="🔍 Tìm tên / mã / phòng ban…"
                       t-att-value="state.search"
                       t-on-input="ev => state.search = ev.target.value"/>
                <button class="o_vdnv_add" t-on-click="() => this.openAdd()">+ Thêm NV</button>
                <button class="o_vdnv_reload" title="Tải lại" t-on-click="() => this.load()">↻</button>
            </div>

            <!-- Tab -->
            <div class="o_vdnv_tabs">
                <button t-att-class="'o_vdnv_tab' + (state.tab === 'working' ? ' o_on' : '')"
                        t-on-click="() => state.tab = 'working'">
                    Đang hoạt động <span class="o_vdnv_tabn" t-esc="state.working.length"/>
                </button>
                <button t-att-class="'o_vdnv_tab' + (state.tab === 'off' ? ' o_on' : '')"
                        t-on-click="() => state.tab = 'off'">
                    Nghỉ việc / Tạm dừng <span class="o_vdnv_tabn" t-esc="state.off.length"/>
                </button>
            </div>

            <div t-if="state.loading" class="o_vdnv_loading">Đang tải danh sách nhân viên…</div>
            <div t-else="" class="o_vdnv_tablewrap">
                <table class="o_vdnv_table">
                    <thead>
                        <tr>
                            <th class="o_vdnv_c_code">Mã</th>
                            <th class="o_vdnv_c_name">Tên nhân viên</th>
                            <th class="o_vdnv_c_role">Chức vụ</th>
                            <th class="o_vdnv_c_login">Đăng nhập</th>
                            <th class="o_vdnv_c_cnt">Số khách</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="groups" t-as="g" t-key="g.team">
                            <tr class="o_vdnv_grouprow" t-attf-style="--c:{{g.color}}">
                                <td colspan="5">
                                    <span class="o_vdnv_groupname" t-esc="g.team"/>
                                    <span class="o_vdnv_groupcnt" t-esc="g.users.length"/>
                                </td>
                            </tr>
                            <tr t-foreach="g.users" t-as="u" t-key="u.id"
                                t-attf-class="o_vdnv_row {{u.active ? '' : 'o_off'}}"
                                t-attf-style="--c:{{u.team_color}}"
                                t-att-title="u.login + ' — bấm để sửa'"
                                t-on-click="() => this.openEdit(u)">
                                <td class="o_vdnv_c_code"><span class="o_vdnv_code" t-esc="u.code"/></td>
                                <td class="o_vdnv_c_name">
                                    <span class="o_vdnv_name" t-esc="u.name"/>
                                    <span t-if="u.is_leader" class="o_vdnv_badge">★ Trưởng nhóm</span>
                                    <span t-if="!u.active" class="o_vdnv_badge o_vdnv_badge_off">nghỉ</span>
                                </td>
                                <td class="o_vdnv_c_role" t-esc="u.role_label"/>
                                <td class="o_vdnv_c_login" t-esc="u.login"/>
                                <td class="o_vdnv_c_cnt">
                                    <t t-if="u.lead_count" t-esc="u.lead_count"/>
                                    <t t-else="">—</t>
                                </td>
                            </tr>
                        </t>
                        <tr t-if="!groups.length">
                            <td colspan="5" class="o_vdnv_empty">— Không có nhân viên —</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="o_vdnv_hint">💡 Bấm <b>+ Thêm NV</b> để thêm · bấm 1 nhân viên để sửa / đổi mật khẩu / cho nghỉ / xóa.</div>

            <!-- ===== POPUP THÊM / SỬA ===== -->
            <t t-if="state.form">
                <div class="o_vdnv_mask" t-on-click="() => this.closeForm()"/>
                <div class="o_vdnv_modal">
                    <div class="o_vdnv_mhd">
                        <span t-if="state.form.id"><i class="fa fa-user-circle me-2"/>Sửa thông tin nhân viên</span>
                        <span t-else=""><i class="fa fa-user-plus me-2"/>Thêm nhân viên mới</span>
                        <button class="o_vdnv_x" t-on-click="() => this.closeForm()">×</button>
                    </div>
                    <div class="o_vdnv_mbd">
                        <label class="o_vdnv_f">
                            <span>Tên nhân viên</span>
                            <input class="o_vdnv_in" t-model="state.form.name" placeholder="Họ và tên"/>
                        </label>
                        <label class="o_vdnv_f">
                            <span>Tên đăng nhập</span>
                            <input class="o_vdnv_in" t-model="state.form.login" placeholder="tên đăng nhập"/>
                        </label>
                        <label class="o_vdnv_f">
                            <span>Email <i class="o_vdnv_opt">(không bắt buộc)</i></span>
                            <input class="o_vdnv_in" t-model="state.form.email" placeholder="email@…"/>
                        </label>
                        <div class="o_vdnv_f2">
                            <label class="o_vdnv_f">
                                <span>Chức vụ</span>
                                <select class="o_vdnv_in" t-model="state.form.role">
                                    <option t-foreach="state.form.roles" t-as="o" t-key="o.value"
                                            t-att-value="o.value" t-esc="o.label"/>
                                </select>
                            </label>
                            <label class="o_vdnv_f">
                                <span>Phòng ban</span>
                                <select class="o_vdnv_in" t-model="state.form.team">
                                    <option value="">(Tự suy từ tên)</option>
                                    <option t-foreach="state.form.teams" t-as="o" t-key="o.value"
                                            t-att-value="o.value" t-esc="o.label"/>
                                </select>
                            </label>
                        </div>
                        <div t-if="state.form.id and state.form.admin_password" class="o_vdnv_pw">
                            <i class="fa fa-key me-1"/>Mật khẩu đã cấp: <b t-esc="state.form.admin_password"/>
                        </div>
                        <label class="o_vdnv_f">
                            <span t-if="state.form.id">Đặt mật khẩu mới <i class="o_vdnv_opt">(để trống nếu không đổi)</i></span>
                            <span t-else="">Mật khẩu đăng nhập <i class="o_vdnv_opt">(bắt buộc, tối thiểu 6 ký tự)</i></span>
                            <input class="o_vdnv_in" t-model="state.form.password" placeholder="Tối thiểu 6 ký tự"/>
                        </label>
                    </div>
                    <div class="o_vdnv_mft">
                        <t t-if="state.form.id">
                            <button t-if="state.form.active" class="o_vdnv_b o_vdnv_b_off"
                                    t-att-disabled="state.saving" t-on-click="() => this.toggleActive()">⏸ Cho nghỉ việc</button>
                            <button t-else="" class="o_vdnv_b o_vdnv_b_on"
                                    t-att-disabled="state.saving" t-on-click="() => this.toggleActive()">▶ Kích hoạt lại</button>
                            <button class="o_vdnv_b o_vdnv_b_del"
                                    t-att-disabled="state.saving" t-on-click="() => this.remove()">🗑 Xóa</button>
                        </t>
                        <span class="o_vdnv_sp"/>
                        <button class="o_vdnv_b o_vdnv_b_cancel" t-on-click="() => this.closeForm()">Huỷ</button>
                        <button class="o_vdnv_b o_vdnv_b_save"
                                t-att-disabled="state.saving" t-on-click="() => this.save()">
                            <t t-if="state.saving">Đang lưu…</t>
                            <t t-elif="state.form.id">💾 Lưu</t>
                            <t t-else="">➕ Thêm</t>
                        </button>
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
