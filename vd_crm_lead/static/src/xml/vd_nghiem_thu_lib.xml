<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- 3 nút nổi THƯ VIỆN tài liệu (đặt dưới nút Mẫu nhà) -->
    <t t-name="vd_crm_lead.DriveLibsButton">
        <t t-if="!hidden">
            <t t-foreach="libs" t-as="lib" t-key="lib.key">
                <button t-attf-class="o_vd_lib_filter {{lib.cls}}"
                        t-on-click="() => this.open(lib)" t-att-title="lib.title">
                    <span class="o_vd_lib_ico"><i t-attf-class="fa {{lib.icon}}"/></span>
                    <span class="o_vd_lib_txt"><t t-esc="lib.title"/></span>
                </button>
            </t>
        </t>
    </t>

    <!-- Popup: lưới PHẲNG toàn bộ file (mỗi file 1 thẻ: tên + Tải cùng dòng) -->
    <t t-name="vd_crm_lead.DriveLibDialog">
        <Dialog title="props.libTitle" size="'xl'" contentClass="'o_vd_nt_modal'">
            <div class="o_vd_nt_wrap">
                <div t-if="state.loading" class="o_vd_nt_center">
                    <i class="fa fa-spinner fa-spin me-1"/>Đang tải danh sách…
                </div>
                <div t-elif="state.error" class="o_vd_nt_err">
                    <i class="fa fa-exclamation-triangle me-1"/><t t-esc="state.error"/>
                </div>
                <div t-elif="!allFiles.length" class="o_vd_nt_center">Chưa có tài liệu.</div>
                <t t-else="">
                    <!-- BỘ LỌC -->
                    <div t-if="showFilters" class="o_vd_nt_filters">
                        <!-- Công năng: theo số tầng + mặt tiền -->
                        <t t-if="isCnLib">
                            <div class="o_vd_nt_frow">
                                <span class="o_vd_nt_flabel">🏢 Số tầng:</span>
                                <button class="o_vd_nt_fchip" t-att-class="{'o_active': state.fFloors === null}"
                                        t-on-click="() => this.setFloors(null)">Tất cả</button>
                                <t t-foreach="floorsList" t-as="v" t-key="v">
                                    <button class="o_vd_nt_fchip" t-att-class="{'o_active': state.fFloors === v}"
                                            t-on-click="() => this.setFloors(v)"><t t-esc="floorLabel(v)"/></button>
                                </t>
                            </div>
                            <div class="o_vd_nt_frow">
                                <span class="o_vd_nt_flabel">📐 Mặt tiền:</span>
                                <button class="o_vd_nt_fchip" t-att-class="{'o_active': state.fFront === null}"
                                        t-on-click="() => this.setFront(null)">Tất cả</button>
                                <t t-foreach="frontList" t-as="v" t-key="v">
                                    <button class="o_vd_nt_fchip" t-att-class="{'o_active': state.fFront === v}"
                                            t-on-click="() => this.setFront(v)"><t t-esc="v"/>m</button>
                                </t>
                            </div>
                        </t>
                        <!-- Video nghiệm thu: theo HẠNG MỤC (từ khóa tên video) -->
                        <t t-if="isNtLib">
                            <div class="o_vd_nt_frow">
                                <span class="o_vd_nt_flabel">🏗️ Hạng mục:</span>
                                <button class="o_vd_nt_fchip" t-att-class="{'o_active': state.fCat === null}"
                                        t-on-click="() => this.setCat(null)">Tất cả</button>
                                <t t-foreach="ntCatsList" t-as="c" t-key="c.key">
                                    <button class="o_vd_nt_fchip" t-att-class="{'o_active': state.fCat === c.key}"
                                            t-on-click="() => this.setCat(c.key)"><t t-esc="c.label"/></button>
                                </t>
                            </div>
                            <!-- Chọn tất cả + tải hàng loạt -->
                            <div t-if="showBulk" class="o_vd_nt_frow o_vd_nt_bulkrow">
                                <label class="o_vd_nt_selall">
                                    <input type="checkbox" t-att-checked="allDisplayedSelected"
                                           t-on-change="() => this.toggleSelectAll()"/>
                                    <span>Chọn tất cả (<t t-esc="displayedVideos.length"/> video)</span>
                                </label>
                                <button class="o_vd_nt_dlall" t-att-disabled="!selCount"
                                        t-on-click="() => this.downloadSelected()">
                                    <i class="fa fa-download me-1"/>Tải <t t-esc="selCount"/> video đã chọn
                                </button>
                            </div>
                        </t>
                    </div>
                    <div t-if="filteredEmpty" class="o_vd_nt_center">Không có mục nào khớp bộ lọc.</div>
                    <t t-foreach="displayGroups" t-as="g" t-key="g_index">
                        <div t-if="g.files.length" class="o_vd_nt_group">
                            <div class="o_vd_nt_grouphead">
                                <i class="fa fa-folder-open me-1"/><t t-esc="g.name"/>
                                <span class="o_vd_nt_gcount">(<t t-esc="g.files.length"/>)</span>
                            </div>
                            <div class="o_vd_nt_grid" t-att-class="{'o_vd_nt_grid_dense': isNtLib}">
                                <t t-foreach="g.files" t-as="f" t-key="f.id">
                                    <!-- VIDEO/ẢNH: thẻ có ảnh xem trước -->
                                    <div t-if="hasThumb(f)" class="o_vd_dl_card"
                                         t-att-class="{'o_vd_dl_card_sel': isSelected(f.id)}">
                                        <div class="o_vd_dl_thumb" t-on-click="() => this.openFile(f.id)">
                                            <label t-if="isNtLib" class="o_vd_dl_check" t-on-click.stop="() => {}">
                                                <input type="checkbox" t-att-checked="isSelected(f.id)"
                                                       t-on-change="() => this.toggleSel(f.id)"/>
                                            </label>
                                            <i t-attf-class="fa {{fileIcon(f)}} o_vd_dl_fallico"/>
                                            <img t-att-src="thumb(f.id)" loading="lazy"/>
                                        </div>
                                        <div class="o_vd_dl_foot">
                                            <span class="o_vd_dl_name" t-att-title="f.name"><t t-esc="displayName(f.name)"/></span>
                                            <a class="o_vd_dl_icon" t-att-href="dlUrl(f.id)" title="Tải video về máy"><i class="fa fa-download"/></a>
                                        </div>
                                    </div>
                                    <!-- TÀI LIỆU: thẻ NHỎ ngang; bấm tên = mở xem; nút chính = Tạo bản sao -->
                                    <div t-else="" class="o_vd_dl_doc">
                                        <i t-attf-class="fa {{fileIcon(f)}} o_vd_dl_docmini"/>
                                        <span class="o_vd_dl_docname" t-att-title="f.name"
                                              t-on-click="() => this.openFile(f.id)"><t t-esc="displayName(f.name)"/></span>
                                        <a t-if="canCopy(f)" class="o_vd_dl_copybtn"
                                           t-att-href="copyUrl(f)" target="_blank"
                                           title="Tạo bản sao để điền (cần đăng nhập Google)">
                                            <i class="fa fa-copy me-1"/>Tạo bản sao
                                        </a>
                                        <a t-else="" class="o_vd_dl_dlmini" t-att-href="dlUrl(f.id)"
                                           title="Tải về máy"><i class="fa fa-download"/></a>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>
                </t>
            </div>
            <!-- Bỏ chân popup + 2 nút (user 2026-07-18): footer slot RỖNG để không
                 hiện nút mặc định; SCSS ẩn hẳn .modal-footer của dialog này. Đóng
                 bằng nút ✕ góc phải. -->
            <t t-set-slot="footer"></t>
        </Dialog>
    </t>

</templates>
