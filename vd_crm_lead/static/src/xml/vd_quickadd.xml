<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Icon nguồn — logo thật của hãng (dùng chung dropdown + bảng). -->
    <t t-name="vd_crm_lead.QuickAddSrcIcon">
        <i t-if="skey === 'facebook'" class="fa fa-facebook o_vd_qa_ic o_vd_qa_ic_fb"/>
        <img t-elif="skey === 'zalo'" class="o_vd_qa_ic o_vd_qa_ic_img"
             src="/vd_crm_lead/static/src/img/zalo.webp" alt="Zalo"/>
        <svg t-elif="skey === 'tiktok'" class="o_vd_qa_ic o_vd_qa_ic_tt"
             xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="15" height="15">
            <path fill="currentColor" d="M41 16.5c-2.7-.2-5.2-1.2-7.2-2.9-1.3-1.1-2.4-2.5-3.1-4.1-.4-.8-.6-1.7-.7-2.6h-7v25.3c0 2.9-2.3 5.2-5.2 5.2s-5.2-2.3-5.2-5.2 2.3-5.2 5.2-5.2c.5 0 1 .1 1.5.2v-7.1c-.5-.1-1-.1-1.5-.1-6.8 0-12.3 5.5-12.3 12.3S11 44.5 17.8 44.5s12.3-5.5 12.3-12.3V19.6c2.8 2.1 6.4 3.4 10.2 3.4 .2 0 .4 0 .7-.1V16.5z"/>
        </svg>
        <i t-elif="skey === 'referral'" class="fa fa-handshake-o o_vd_qa_ic o_vd_qa_ic_gen"/>
        <i t-elif="skey === 'manual'" class="fa fa-pencil o_vd_qa_ic o_vd_qa_ic_gen"/>
        <i t-else="" class="fa fa-magnet o_vd_qa_ic o_vd_qa_ic_quet"/>
    </t>

    <t t-name="vd_crm_lead.QuickAddDialog">
        <Dialog title="'➕ Thêm khách hàng mới'" size="'lg'">
            <div class="o_vd_qa">
                <t t-if="state.loading">
                    <div class="o_vd_qa_load">Đang tải…</div>
                </t>
                <t t-else="">
                    <!-- ===== FORM NHẬP 1 KHÁCH + nút Excel ===== -->
                    <div t-if="!state.picking" class="o_vd_qa_form">
                        <input class="o_vd_qa_in o_vd_qa_phone" t-model="state.form.phone"
                               placeholder="SĐT *" t-on-keydown="onFormKey"/>
                        <input class="o_vd_qa_in o_vd_qa_name" t-model="state.form.name"
                               placeholder="Tên khách hàng" t-on-keydown="onFormKey"/>
                        <div t-attf-class="o_vd_qa_srcdd {{state.srcOpen ? 'o_open' : ''}}">
                            <button type="button" class="o_vd_qa_srcbtn"
                                    t-on-click="() => this.toggleSrc()">
                                <span class="o_vd_qa_srcval">
                                    <t t-call="vd_crm_lead.QuickAddSrcIcon">
                                        <t t-set="skey" t-value="state.form.source"/>
                                    </t>
                                    <span class="o_vd_qa_srctxt" t-esc="sourceLabel(state.form.source)"/>
                                </span>
                                <i class="fa fa-caret-down o_vd_qa_srccaret"/>
                            </button>
                            <div t-if="state.srcOpen" class="o_vd_qa_srcback"
                                 t-on-click="() => this.state.srcOpen = false"/>
                            <div t-if="state.srcOpen" class="o_vd_qa_srcmenu">
                                <div t-foreach="state.sources" t-as="s" t-key="s.key"
                                     t-attf-class="o_vd_qa_srcopt {{state.form.source === s.key ? 'o_sel' : ''}}"
                                     t-on-click="() => this.pickSource(s.key)">
                                    <t t-call="vd_crm_lead.QuickAddSrcIcon">
                                        <t t-set="skey" t-value="s.key"/>
                                    </t>
                                    <span t-esc="s.label"/>
                                </div>
                            </div>
                        </div>
                        <input class="o_vd_qa_in o_vd_qa_info" t-model="state.form.info"
                               placeholder="Thông tin khách (mẫu nhà, DT, số tầng T1/T2…)"
                               t-on-keydown="onFormKey"/>
                        <button class="btn btn-primary o_vd_qa_add" t-on-click="() => this.addRow()"
                                title="Thêm vào danh sách">
                            <i class="fa fa-plus"/>
                        </button>
                        <button class="btn btn-outline-secondary o_vd_qa_xls"
                                t-on-click="() => this.triggerFile()" t-att-disabled="state.busy">
                            <i class="fa fa-file-excel-o me-1"/>Upload Excel
                        </button>
                        <input type="file" class="d-none" t-ref="fileInput"
                               accept=".xlsx,.xls,.csv" t-on-change="onFile"/>
                    </div>

                    <!-- Banner tóm tắt sau khi nạp Excel -->
                    <div t-if="state.summary and !state.picking" class="o_vd_qa_summary">
                        <t t-esc="state.summary"/>
                    </div>

                    <!-- ===== DANH SÁCH KH ĐÃ THÊM ===== -->
                    <div t-if="!state.picking" class="o_vd_qa_listwrap">
                        <div t-if="!state.rows.length" class="o_vd_qa_empty">
                            Chưa có khách nào. Nhập SĐT rồi bấm <b>+</b>, hoặc <b>Upload Excel</b>.
                        </div>
                        <table t-else="" class="o_vd_qa_table">
                            <thead>
                                <tr>
                                    <th class="o_vd_qa_c_no">#</th>
                                    <th class="o_vd_qa_c_phone">SĐT</th>
                                    <th class="o_vd_qa_c_name">Tên khách hàng</th>
                                    <th class="o_vd_qa_c_src">Nguồn</th>
                                    <th class="o_vd_qa_c_info">Thông tin</th>
                                    <th class="o_vd_qa_c_x"></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="state.rows" t-as="r" t-key="r_index"
                                    t-att-class="r.excel ? 'o_vd_qa_fromxls' : ''">
                                    <td class="o_vd_qa_c_no" t-esc="r_index + 1"/>
                                    <td class="o_vd_qa_c_phone"><b t-esc="r.phone"/></td>
                                    <td class="o_vd_qa_c_name" t-esc="r.name"/>
                                    <td class="o_vd_qa_c_src">
                                        <t t-call="vd_crm_lead.QuickAddSrcIcon">
                                            <t t-set="skey" t-value="r.source"/>
                                        </t>
                                        <span t-esc="sourceLabel(r.source)"/>
                                    </td>
                                    <td class="o_vd_qa_c_info" t-esc="r.info"/>
                                    <td class="o_vd_qa_c_x">
                                        <button class="o_vd_qa_del" t-on-click="() => this.removeRow(r_index)"
                                                title="Bỏ dòng này"><i class="fa fa-times"/></button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <div t-if="state.rows.length" class="o_vd_qa_count">
                            Tổng: <b t-esc="state.rows.length"/> khách
                        </div>
                    </div>

                    <!-- ===== CHỌN NHÂN VIÊN ĐỂ CHIA ===== -->
                    <div t-if="state.picking" class="o_vd_qa_pick">
                        <div class="o_vd_qa_pick_head">
                            <span>Chia <b t-esc="state.rows.length"/> khách — tích chọn nhân viên
                                (<b t-esc="selectedCount"/> đã chọn):</span>
                            <input class="o_vd_qa_nvsearch" t-model="state.nvSearch"
                                   placeholder="🔍 Tìm nhân viên…"/>
                        </div>
                        <div class="o_vd_qa_nvgrid">
                            <label t-foreach="nvList" t-as="n" t-key="n.id"
                                   t-attf-class="o_vd_qa_nv {{state.selected[n.id] ? 'o_sel' : ''}}">
                                <input type="checkbox" t-att-checked="state.selected[n.id]"
                                       t-on-change="() => this.toggleNv(n.id)"/>
                                <span class="o_vd_qa_nv_name" t-esc="n.name"/>
                            </label>
                        </div>
                    </div>
                </t>
            </div>

            <t t-set-slot="footer">
                <t t-if="!state.picking">
                    <button class="btn btn-primary" t-on-click="() => this.openPicker()"
                            t-att-disabled="!state.rows.length">
                        <i class="fa fa-random me-1"/>Chia số
                    </button>
                    <button class="btn btn-secondary" t-on-click="() => this.props.close()">Đóng</button>
                </t>
                <t t-else="">
                    <button class="btn btn-primary" t-on-click="() => this.submit(true)"
                            t-att-disabled="state.busy">
                        <i class="fa fa-balance-scale me-1"/>Chia đều cho TẤT CẢ nhân viên
                    </button>
                    <button class="btn btn-success" t-on-click="() => this.submit(false)"
                            t-att-disabled="state.busy or !selectedCount">
                        <i class="fa fa-check me-1"/>Chia cho NV đã chọn
                    </button>
                    <button class="btn btn-secondary" t-on-click="() => this.state.picking = false">
                        <i class="fa fa-arrow-left me-1"/>Quay lại
                    </button>
                </t>
            </t>
        </Dialog>
    </t>

</templates>
